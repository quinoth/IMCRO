# ─────────────────────────────────────────────────────────────────────────────
# .env.example — шаблон переменных окружения для проекта ИМЦРО
#
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#
# Файл .env исключён из системы контроля версий (.gitignore).
# Никогда не коммитьте .env с реальными секретами.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=mky_user
DB_PASSWORD=17200401dima
DB_NAME=mky_db

# ── JWT-аутентификация ────────────────────────────────────────────────────────
# Сгенерируйте надёжный случайный ключ, например:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ce633a7b4dc26a321a9e24386c8a698262d5a7ff916510febbb6c7f5873da7bf

# ── Шифрование персональных данных ТПМПК ─────────────────────────────────────
# Используется для шифрования ФИО и телефона в заявках ТПМПК.
# Сгенерируйте надёжный случайный ключ:
#   python -c "import secrets; print(secrets.token_hex(32))"
PD_ENCRYPTION_KEY=852db840eb0bc1a6cbddf7be0fa13cf134049137a2b6fa0962f847f7c5b372ef

# ── CORS ──────────────────────────────────────────────────────────────────────
# Для production через Nginx не нужен — frontend и backend на одном origin.
# Для dev или при прямом доступе к backend укажите разрешённые origins:
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Rate limiting for sensitive API endpoints. Keep enabled in production.
RATE_LIMIT_ENABLED=true

# ── Frontend API URL (только для локальной разработки без Docker) ─────────────
# В production-сборке через Docker это значение должно быть пустым:
# frontend обращается к backend через Nginx по относительным путям.
# Для локальной разработки (npm run dev):
#   VITE_API_URL=http://localhost:8000
VITE_API_URL=

# ── Тестовые пользователи (только для разработки) ────────────────────────────
# При значении true backend автоматически создаёт dev-аккаунты при старте.
# Для production и демонстрационного развёртывания установите false.
ENABLE_DEV_TEST_USERS=false
